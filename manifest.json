{
  "schemaVersion": 1,
  "id": "omarchy-netcaptain",
  "name": "NetCaptain",
  "version": "0.4.1",
  "author": "Chamal1120",
  "license": "MIT",
  "description": "Daily, monthly, and per-connection network data usage with data limits, stored in a local SQLite database.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "NetCaptain",
    "description": "Download and upload per day, month, and connection",
    "category": "System",
    "aliases": [
      "network usage",
      "data usage",
      "bandwidth",
      "traffic"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Update interval (seconds)",
        "min": 10,
        "max": 3600,
        "step": 10,
        "defaultValue": 60
      },
      {
        "key": "notifyLimits",
        "type": "boolean",
        "label": "Notify at 90% and when a data limit is reached",
        "defaultValue": true
      }
    ]
  }
}
